{
  "name": "oop",
  "version": "2.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --coverage",
    "test:e2e": "start-server-and-test 'vite --host --port 5173' 5173 'cypress open --e2e --config baseUrl=http://localhost:5173/oop/ --env environment=local'",
    "test:e2e:headless": "start-server-and-test 'vite --host --port 5173' 5173 'cypress run --browser chrome --config baseUrl=http://localhost:5173/oop/ --env environment=local'",
    "test:e2e:dev": "cypress open --e2e --config baseUrl=http://dev.my.gov.bc.ca/oop/ --env environment=dev",
    "test:e2e:test": "cypress open --e2e --config baseUrl=http://test.my.gov.bc.ca/oop/ --env environment=test",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@bcgov/bootstrap-v5-theme": "^1.0.1",
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/vue-fontawesome": "^3.0.1",
    "@vue/compat": "^3.1.0",
    "@vuelidate/core": "^2.0.0-alpha.41",
    "@vuelidate/validators": "^2.0.0-alpha.29",
    "axios": "^1.6.2",
    "common-lib-vue": "^3.1.1-alpha.7",
    "core-js": "^3.6.5",
    "date-fns": "^2.16.1",
    "uuid": "^14.0.1",
    "vue": "^3.1.0",
    "vue-router": "^4.0.13",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/test-utils": "^2.0.0",
    "cypress": "^15.18.1",
    "eslint": "^10.7.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-mocha": "^10.0.3",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^30.0.1",
    "start-server-and-test": "^3.0.11",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
